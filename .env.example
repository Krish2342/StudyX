# Copy this file to `.env.local` in the same folder, then fill in your own values.
# `.env.local` is ignored by git. Never commit real keys.
#
# Where to find these: Supabase dashboard -> your project -> Settings -> API.
# Both values below are PUBLIC by design (they ship in the browser bundle).
# Safety comes from Postgres row-level security, not from hiding these.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NOT used by the frontend and must never be added here:
#   SUPABASE_SERVICE_ROLE_KEY
#   OPENAI_API_KEY / GEMINI_API_KEY / GROQ_API_KEY
# Those belong in server-side secrets (Supabase Edge Functions or the hosting
# dashboard), because anything in a VITE_ variable is readable by every visitor.
